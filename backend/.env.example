NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hustle_db?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_STATE_SECRET="replace-with-a-long-random-oauth-state-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
CLIENT_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10
POST_RATE_LIMIT_MAX=20
ENGAGEMENT_RATE_LIMIT_MAX=120
COMMENT_RATE_LIMIT_MAX=60
MAX_MEDIA_FILES=10
MAX_MEDIA_FILE_SIZE_MB=25
AUTH_REFRESH_COOKIE_NAME="hustle_refresh_token"
AUTH_COOKIE_DOMAIN=""
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_SET_REFRESH_COOKIE=true
AUTH_ALLOWED_REDIRECTS="http://localhost:3000,hustle://auth/callback"
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRES_HOURS=24
OAUTH_HANDOFF_EXPIRES_MINUTES=5
OAUTH_STATE_EXPIRES_MINUTES=10
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
APPLE_CALLBACK_URL="http://localhost:4000/api/auth/apple/callback"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
