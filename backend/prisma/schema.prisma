generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  fullName  String?
  role      Role     @default(CLIENT)

  roleRequests RoleRequest[]
  posts    Post[]
  likes         Like[]       // 👈 ADD THIS
  comments      Comment[]    // 👈 ADD THIS
  

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum Role {
  CLIENT
  HUSTLER
  AGENT
  ADMIN
}

model RoleRequest {
  id        String   @id @default(cuid())
  userId    String
  requestedRole Role

  status    RequestStatus @default(PENDING)

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  mediaUrl  String
  publicId  String?
  caption   String?
  type      String   // image | video

  createdAt DateTime @default(now())
  
  likes Like[]
  comments Comment[]
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String

  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(cuid())

  content   String

  userId    String
  postId    String

  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])

  createdAt DateTime @default(now())
}