generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  fullName  String?
  role      Role     @default(CLIENT)

  roleRequests RoleRequest[]
    posts    Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum Role {
  CLIENT
  HUSTLER
  AGENT
  ADMIN
}

model RoleRequest {
  id        String   @id @default(cuid())
  userId    String
  requestedRole Role

  status    RequestStatus @default(PENDING)

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  mediaUrl  String
  publicId  String?
  caption   String?
  type      String   // image | video

  createdAt DateTime @default(now())
}